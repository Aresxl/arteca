---
// Images
import ArrowDown from "@/assets/icons/arrow-down.svg";

// Components
import LinkOrButton from "../ui/LinkOrButton.astro";
import RollLink from "../ui/RollLink.astro";
---

<header class="site__header | grid-main">
  {/* Carries the scrolled frost. A backdrop-filter on the header itself makes
      iOS 26's status-bar colour sampler bail out ("multiple colours"), so the
      blur lives on this absolutely-positioned child, which the sampler skips
      on its way up to the header's own background-color. */}
  <div class="site__header-frost" aria-hidden="true"></div>

  <div class="site__header-inner">
    <RollLink href="/" text="Vyteca" class="home-link site-logo" aria-label="Vyteca home" />

    <LinkOrButton
      as="a"
      href="#your-venue"
      variant="primary"
      text="Book your call"
      data-track="cta"
    >
      <ArrowDown />
    </LinkOrButton>
  </div>
</header>

<style>
  /* iOS 26 Safari tints the status bar by sampling one point (viewport centre,
     4px down) and walking up for a fixed/sticky ancestor with a real
     background-color. This bar is that ancestor — see the fuller note in
     Header.astro. Load bearing: a plain background-color on THIS element, no
     backdrop-filter in the walk (it lives on .site__header-frost), and nothing
     position:fixed covering the top of the viewport above it. */
  .site__header {
    position: sticky;
    z-index: 900;
    top: 0;
    padding-block: var(--spacing-xs);
    min-height: var(--header-h);

    /* Was `transparent`, which gave the sampler nothing to read. This is the
       page background at full opacity — visually identical to transparent at
       scroll-top, because the hero sits on exactly this colour. */
    background-color: var(--clr-bg-primary-dark);
    border-bottom: 1px solid transparent;

    /* Blur snaps on with .is-scrolled rather than transitioning, so the
       backdrop isn't re-sampled every frame — same treatment as the site header. */
    transition:
      border-color 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  /* The frosted layer. Out of flow, so .grid-main's column rule doesn't box it
     in; z-index 0 sits it above the header's background but below the bar's
     content, so the blur has the page behind it and never washes the wordmark. */
  .site__header-frost {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    pointer-events: none;
    background-color: hsl(from var(--clr-neutral-900) h s l / 0.85);
    transition: opacity 0.4s var(--ease);
  }

  .site__header.is-scrolled .site__header-frost {
    opacity: 1;
    /* Standard property only. Lightning CSS adds the -webkit- prefix from the
       build's css targets; writing both by hand makes it collapse to -webkit-
       only at minify time, which drops the blur in Firefox. */
    backdrop-filter: blur(20px) saturate(1.4);
  }

  /* Once scrolled the bar "pops" with a hairline border and faint shadow —
     identical treatment to the site header. */
  .site__header.is-scrolled {
    border-bottom-color: hsl(0 0% 100% / 0.06);
    box-shadow: 0 8px 32px hsl(0 0% 0% / 0.18);
  }

  @media (prefers-reduced-motion: reduce) {
    .site__header,
    .site__header-frost {
      transition: none;
    }
  }

  .site__header-inner {
    position: relative;
    /* Above .site__header-frost so the blur never washes over the wordmark. */
    z-index: 1;

    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  /* Wordmark hard left; the CTA is pushed to the right. */
  .home-link {
    margin-right: auto;

    /* The wordmark's -0.06em letter-spacing pulls the box in past the final
       glyph, then RollLink's overflow:hidden clips the "A". A hair of inline-end
       padding restores the clip edge without shifting the hard-left layout. */
    padding-inline-end: 0.12em;

    /* Keep the wordmark gold through the roll. RollLink's own colour rule is
       unlayered, so it outranks .site-logo's gold (in @layer typography) and
       would otherwise fall back to inherited currentColor — drive the colour
       through the roll's own tokens instead. */
    --roll-link-color: var(--clr-primary-gold);
    --roll-link-color-hover: var(--clr-primary-gold);
    --roll-link-color-current: var(--clr-primary-gold);
    --roll-link-duration: 0.45s;
    --roll-link-stagger: 18ms;
  }

  .btn {
    min-height: auto;
  }

  @media (min-width: 48rem) {
    .site__header {
      padding-block: var(--spacing-sm);
    }

    .site__header-inner .btn {
      min-height: auto;
      font-size: var(--fs-350);
    }
  }

  @media (min-width: 62.5rem) {
    .site__header-inner {
      gap: var(--spacing-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site__header {
      transition: none;
    }
  }
</style>

<script>
  function initLandingHeader() {
    const header = document.querySelector<HTMLElement>(`.site__header`);
    // Bail on routes without this header. The astro:page-load listener is
    // global, so this runs on every navigation.
    if (!header) return;

    const controller = new AbortController();
    const { signal } = controller;

    // Toggle the "popped" header state once the user scrolls away from the top.
    let headerTicking = false;
    function syncHeaderState() {
      header?.classList.toggle(`is-scrolled`, window.scrollY > 24);
      headerTicking = false;
    }

    window.addEventListener(
      `scroll`,
      () => {
        if (!headerTicking) {
          requestAnimationFrame(syncHeaderState);
          headerTicking = true;
        }
      },
      { passive: true, signal },
    );

    syncHeaderState();

    // Remove the scroll listener before the next swap; the fresh header swapped
    // in gets its own binding on the following astro:page-load.
    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort();
      },
      { once: true },
    );
  }

  document.addEventListener("astro:page-load", initLandingHeader);
</script>
